# Copy locally to runtime.env.yaml and replace every placeholder.
# Do not put passwords or Stripe secrets here.
APP_ENV: production
AUTH_MODE: firebase
MODEL_PROVIDER: google_cloud
MODEL_ID: gemini-3.8-flash
MODEL_LOCATION: us
GOOGLE_CLOUD_PROJECT: REPLACE_PROJECT
FIREBASE_PROJECT_ID: REPLACE_FIREBASE_PROJECT
FIREBASE_API_KEY: REPLACE_PUBLIC_API_KEY
STORAGE_PROVIDER: gcs
GCS_BUCKET: REPLACE_BUCKET
APP_ORIGIN: https://REPLACE_APP_HOST
ALLOWED_ORIGINS: https://REPLACE_APP_HOST
AUTO_CREATE_SCHEMA: "false"
AUTO_SEED: "false"
DEMO_BILLING_ENABLED: "false"
BILLING_ENABLED: "false"
BILLING_TERMS_APPROVED: "false"
UPLOAD_SCANNING_REQUIRED: "true"
CLAMAV_HOST: REPLACE_PRIVATE_SCANNER
CLAMAV_PORT: "3310"
ENABLE_EXPERIMENTAL_AGENTS: "false"

MFA_REQUIRED: "true"
AUTH_SESSION_MAX_AGE_SECONDS: "43200"
AUTH_RECENT_SECONDS: "300"
FIREBASE_AUTH_DOMAIN: "REPLACE_PROJECT.firebaseapp.com"
FIREBASE_TENANT_ID: ""
