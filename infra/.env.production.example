# Values below are placeholders; this file is NOT executable production configuration.
APP_ENV=production
AUTH_MODE=firebase
MODEL_PROVIDER=google_cloud
MODEL_ID=gemini-3.8-flash
MODEL_LOCATION=us
MODEL_BUDGET_ID=
# Empty denies live application inference. Select only an explicitly approved budget; see docs/MODEL_BUDGETS.md.
GOOGLE_CLOUD_PROJECT=REPLACE_PROJECT
FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT
FIREBASE_API_KEY=REPLACE_PUBLIC_CLIENT_API_KEY
STORAGE_PROVIDER=gcs
GCS_BUCKET=REPLACE_PRIVATE_BUCKET
APP_ORIGIN=https://REPLACE_APP_HOST
ALLOWED_ORIGINS=https://REPLACE_APP_HOST
DATABASE_URL=REPLACE_FROM_SECRET_MANAGER
AUTO_CREATE_SCHEMA=false
AUTO_SEED=false
DEMO_BILLING_ENABLED=false
BILLING_ENABLED=false
BILLING_TERMS_APPROVED=false
UPLOAD_SCANNING_REQUIRED=true
CLAMAV_HOST=REPLACE_REACHABLE_PRIVATE_SCANNER
CLAMAV_PORT=3310
AGENT_TASKS_PER_MONTH=30
AGENT_CONCURRENCY=2
RENEWAL_GRACE_DAYS=0
ENABLE_EXPERIMENTAL_AGENTS=false
SOURCE_FETCH_ENABLED=false

# Identity Platform MFA; real Firebase mode refuses MFA_REQUIRED=false.
MFA_REQUIRED=true
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_RECENT_SECONDS=300
FIREBASE_AUTH_DOMAIN=
FIREBASE_TENANT_ID=
