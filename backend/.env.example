# LOCAL DEMO ONLY. Copy to backend/.env. All live external calls are disabled.
APP_ENV=local
DATABASE_URL=sqlite:///./data/accounting.db
DATA_DIR=./data
AUTH_MODE=dev
MODEL_PROVIDER=mock
MODEL_ID=gemini-3.8-flash
MODEL_LOCATION=us
GOOGLE_CLOUD_PROJECT=
DEMO_BILLING_ENABLED=true
BILLING_ENABLED=false
BILLING_TERMS_APPROVED=false
AUTO_SEED=true
AUTO_CREATE_SCHEMA=true
APP_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AGENT_TASKS_PER_MONTH=30
AGENT_CONCURRENCY=2
RENEWAL_GRACE_DAYS=0
CHAT_MESSAGES_PER_HOUR=30
ENABLE_EXPERIMENTAL_AGENTS=false
UPLOAD_SCANNING_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_API_VERSION=
STORAGE_PROVIDER=local
GCS_BUCKET=
SOURCE_FETCH_ENABLED=false
SEC_USER_AGENT=

# Identity Platform MFA; real Firebase mode refuses MFA_REQUIRED=false.
MFA_REQUIRED=true
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_RECENT_SECONDS=300
FIREBASE_AUTH_DOMAIN=
FIREBASE_TENANT_ID=
